# ===========================
# SERWER
# ===========================
NODE_ENV=production
# PORT jest ustawiany automatycznie przez Railway – nie podawaj ręcznie
# PORT=5000

# ===========================
# BAZA DANYCH
# ===========================
# MongoDB Atlas (darmowe): https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/kalkulator

# ===========================
# JWT TOKENY (min. 32 znaki!)
# ===========================
JWT_ACCESS_SECRET=zmien_ten_sekret_access_minimum_32_znaki_1234567890
JWT_REFRESH_SECRET=zmien_ten_sekret_refresh_minimum_32_znaki_abcdefgh
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ===========================
# FRONTEND URL (Railway URL frontendu)
# ===========================
FRONTEND_URL=https://kalkulator-frontend.up.railway.app

# ===========================
# BOT DISCORD API (Railway URL bota)
# ===========================
BOT_API_URL=https://kalkulator-bot.up.railway.app
BOT_API_SECRET=sekret_komunikacji_backend_bot_min_32znaki_xyz

# ===========================
# SUPERADMIN (seed script)
# ===========================
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ZmienToHaslo!2024
